<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 无 ActionBar 的浅色主题，配合 edge-to-edge 使用 -->
    <style name="Theme.PawPlanet" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_coral</item>
        <item name="colorPrimaryVariant">@color/brand_coral_dark</item>
        <item name="colorSecondary">@color/brand_coral</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- 状态栏透明 + 深色图标（浅色背景）；导航栏用品牌色，浅色图标才看得清 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/brand_coral</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
